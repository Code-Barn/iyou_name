# Caddy reverse proxy configuration for namechart + GrampsWeb
# This file is used when deploying behind Caddy for automatic HTTPS

# Development - uncomment for local testing with Caddy
# {
#     admin off
# }

# Namechart - main application
localhost:80, localhost:8000 {
    reverse_proxy localhost:8000
}

# GrampsWeb - genealogy database (subdomain example)
localhost:8080 {
    reverse_proxy localhost:8080
}


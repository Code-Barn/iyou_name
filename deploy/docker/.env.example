# Genealogy Configuration
# Options: disabled, grampsweb, webtrees, external
GENEALOGY_MODE=disabled

# For external genealogy links (when GENEALOGY_MODE=external)
GENEALOGY_EXTERNAL_URL=https://some-genealogy-site.com

# GrampsWeb settings (when GENEALOGY_MODE=grampsweb)
GRAMPSWEB_TREE=Family Tree
GRAMPSWEB_SECRET_KEY=change-me-generate-with-python-secrets-token-hex-32
GRAMPSWEB_BASE_URL=http://localhost:8080
GRAMPSWEB_CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# WebTrees settings (when GENEALOGY_MODE=webtrees)
WEBTREES_URL=http://localhost:8081
WEBTREES_ADMIN_USER=admin
WEBTREES_ADMIN_EMAIL=admin@example.com
WEBTREES_ADMIN_PASSWORD=changeme123

# OIDC endpoints — defaults follow the 127.0.0.1 Binding Rule
# OIDC_OP_AUTHORIZATION_ENDPOINT=https://iyou.me/openid/authorize/
# OIDC_OP_TOKEN_ENDPOINT=http://127.0.0.1:8000/openid/token/
# OIDC_OP_USER_ENDPOINT=http://127.0.0.1:8000/openid/userinfo/
# OIDC_OP_JWKS_ENDPOINT=http://127.0.0.1:8000/openid/jwks/

# DID backend: "python" (default) or "rust"
# DID_BACKEND=python

# Email (optional - for password reset)
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=True
DEFAULT_FROM_EMAIL=noreply@example.com

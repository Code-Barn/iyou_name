NAME_SECRET_KEY=change-me-to-a-real-secret-key
NAME_DEBUG=False
NAME_ALLOWED_HOSTS=localhost,127.0.0.1,.iyou.me
DATABASE_URL=postgres://iyou_name:iyou_name@localhost:5432/iyou_name
OIDC_RP_CLIENT_SECRET=set-this-to-your-oidc-client-secret

# OIDC endpoints — defaults follow the 127.0.0.1 Binding Rule for unified
# token evaluation against iyou_idp. Override for remote deployment.
# OIDC_OP_AUTHORIZATION_ENDPOINT=https://iyou.me/openid/authorize/
# OIDC_OP_TOKEN_ENDPOINT=http://127.0.0.1:8000/openid/token/
# OIDC_OP_USER_ENDPOINT=http://127.0.0.1:8000/openid/userinfo/
# OIDC_OP_JWKS_ENDPOINT=http://127.0.0.1:8000/openid/jwks/
